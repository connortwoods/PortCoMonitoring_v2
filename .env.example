# Supabase (required)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # or SUPABASE_ANON_KEY for read-only frontend

# SerpAPI (optional; fallback when Wayback has no recent Glassdoor data)
SERPAPI_KEY=

# Email (SendGrid or SMTP)
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
ALERT_FROM_NAME=PortCo Monitoring

# Optional SMTP (if not using SendGrid)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
